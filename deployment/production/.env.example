# Copy to .env, source values from a secret manager, and never commit the file.
DAL_OBSCURA_IMAGE=ghcr.io/snithish/dal-obscura@sha256:REPLACE_WITH_VERIFIED_DIGEST
DAL_OBSCURA_UI_IMAGE=ghcr.io/snithish/dal-obscura-ui@sha256:REPLACE_WITH_VERIFIED_DIGEST

POSTGRES_USER=dal_obscura
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_DB=dal_obscura
DAL_OBSCURA_DATABASE_URL=postgresql+psycopg://dal_obscura:REPLACE_WITH_SECRET@postgres:5432/dal_obscura

DAL_OBSCURA_CONTROL_PLANE_PROFILE=production
DAL_OBSCURA_CONTROL_PLANE_CATALOG_EGRESS_ALLOWLIST=iceberg-catalog.internal,object-store.internal
DAL_OBSCURA_CONTROL_PLANE_HOST=0.0.0.0
DAL_OBSCURA_CONTROL_PLANE_PORT=8820
DAL_OBSCURA_CONTROL_PLANE_ADMIN_TOKEN=REPLACE_WITH_32_PLUS_CHAR_BOOTSTRAP_SECRET
DAL_OBSCURA_CONTROL_PLANE_BOOTSTRAP_ENABLED=false
DAL_OBSCURA_CONTROL_PLANE_CORS_ORIGINS=https://governance.example.com
DAL_OBSCURA_CONTROL_PLANE_OIDC_ISSUER=https://identity.example.com/realms/customer
DAL_OBSCURA_CONTROL_PLANE_OIDC_AUDIENCE=dal-obscura-admin
DAL_OBSCURA_CONTROL_PLANE_OIDC_JWKS_URL=https://identity.example.com/realms/customer/protocol/openid-connect/certs
DAL_OBSCURA_CONTROL_PLANE_OIDC_ADMIN_GROUP=dal-obscura-platform-admins
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_ISSUER=https://identity.example.com/realms/customer
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_CLIENT_ID=dal-obscura-ui
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_REDIRECT_URI=https://governance.example.com/auth/callback
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_POST_LOGOUT_REDIRECT_URI=https://governance.example.com
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_SCOPE=openid profile email

DAL_OBSCURA_TICKET_SECRET=REPLACE_WITH_SECRET
DAL_OBSCURA_DATA_PLANE_PROFILE=production
DAL_OBSCURA_CELL_ID=REPLACE_WITH_PUBLISHED_CELL_UUID
DAL_OBSCURA_LOCATION=grpc+tls://flight.example.com:443
DAL_OBSCURA_DATA_PLANE_HEALTH_HOST=0.0.0.0
DAL_OBSCURA_DATA_PLANE_HEALTH_PORT=8816
DAL_OBSCURA_TLS_CERT=/run/secrets/flight.crt
DAL_OBSCURA_TLS_KEY=/run/secrets/flight.key
DAL_OBSCURA_TLS_CLIENT_CA=/run/secrets/client-ca.crt
DAL_OBSCURA_TLS_VERIFY_CLIENT=true
DAL_OBSCURA_TICKET_CLEANUP_INTERVAL_SECONDS=60
