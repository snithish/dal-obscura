# Secure-local profile. Copy to .env and replace every REPLACE value.
# Compose is layered over ../production/compose.yaml; image values must be
# immutable digests and all secrets/certificates stay outside version control.
DAL_OBSCURA_IMAGE=ghcr.io/snithish/dal-obscura@sha256:REPLACE_WITH_VERIFIED_DIGEST
DAL_OBSCURA_UI_IMAGE=ghcr.io/snithish/dal-obscura-ui@sha256:REPLACE_WITH_VERIFIED_DIGEST
DAL_OBSCURA_POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_VERIFIED_DIGEST
DAL_OBSCURA_EDGE_IMAGE=caddy@sha256:REPLACE_WITH_VERIFIED_DIGEST

POSTGRES_USER=dal_obscura
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_DB=dal_obscura
DAL_OBSCURA_MIGRATION_DB_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
DAL_OBSCURA_CONTROL_PLANE_DB_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
DAL_OBSCURA_DATA_PLANE_DB_PASSWORD=REPLACE_WITH_UNIQUE_SECRET
DAL_OBSCURA_MIGRATION_DATABASE_URL=postgresql+psycopg://dal_obscura_migrator:REPLACE_WITH_SECRET@postgres:5432/dal_obscura
DAL_OBSCURA_CONTROL_PLANE_DATABASE_URL=postgresql+psycopg://dal_obscura_control:REPLACE_WITH_SECRET@postgres:5432/dal_obscura
DAL_OBSCURA_DATA_PLANE_DATABASE_URL=postgresql+psycopg://dal_obscura_reader:REPLACE_WITH_SECRET@postgres:5432/dal_obscura

DAL_OBSCURA_CONTROL_PLANE_PROFILE=production
DAL_OBSCURA_CONTROL_PLANE_CATALOG_EGRESS_ALLOWLIST=iceberg-catalog.internal,object-store.internal
DAL_OBSCURA_CONTROL_PLANE_HOST=0.0.0.0
DAL_OBSCURA_CONTROL_PLANE_PORT=8820
DAL_OBSCURA_CONTROL_PLANE_ADMIN_TOKEN=REPLACE_WITH_32_PLUS_CHAR_BOOTSTRAP_SECRET
DAL_OBSCURA_CONTROL_PLANE_REVIEW_SECRET=REPLACE_WITH_SEPARATE_32_PLUS_CHAR_REVIEW_SECRET
DAL_OBSCURA_CONTROL_PLANE_BOOTSTRAP_ENABLED=false
DAL_OBSCURA_CONTROL_PLANE_CORS_ORIGINS=https://localhost:8443
DAL_OBSCURA_CONTROL_PLANE_TRUSTED_PROXY_PEERS=
DAL_OBSCURA_CONTROL_PLANE_LOGIN_RATE_LIMIT_AGGREGATE_ATTEMPTS=200
DAL_OBSCURA_CONTROL_PLANE_OIDC_ISSUER=https://identity.local.example/realms/dal-obscura
DAL_OBSCURA_CONTROL_PLANE_OIDC_AUDIENCE=dal-obscura-admin
DAL_OBSCURA_CONTROL_PLANE_OIDC_JWKS_URL=https://identity.local.example/realms/dal-obscura/protocol/openid-connect/certs
DAL_OBSCURA_CONTROL_PLANE_OIDC_ADMIN_GROUP=dal-obscura-platform-admins
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_ISSUER=https://identity.local.example/realms/dal-obscura
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_CLIENT_ID=dal-obscura-ui
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_REDIRECT_URI=https://localhost:8443/auth/callback
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_POST_LOGOUT_REDIRECT_URI=https://localhost:8443
DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_SCOPE=openid profile email
DAL_OBSCURA_PLUGIN_LOCK_FILE=

DAL_OBSCURA_TICKET_SECRET=REPLACE_WITH_SECRET
DAL_OBSCURA_TICKET_PREVIOUS_SECRETS=
DAL_OBSCURA_DATA_PLANE_PROFILE=production
DAL_OBSCURA_CELL_ID=REPLACE_WITH_PUBLISHED_CELL_UUID
DAL_OBSCURA_LOCATION=grpc+tls://localhost:8815
DAL_OBSCURA_DATA_PLANE_HEALTH_HOST=0.0.0.0
DAL_OBSCURA_DATA_PLANE_HEALTH_PORT=8816
DAL_OBSCURA_TLS_CERT=/run/secrets/flight.crt
DAL_OBSCURA_TLS_KEY=/run/secrets/flight.key
DAL_OBSCURA_TLS_CLIENT_CA=/run/secrets/client-ca.crt
DAL_OBSCURA_TLS_VERIFY_CLIENT=true

# Generated by ./run init; these paths are relative to the production compose
# file because it is the base compose file in the layered command.
DAL_OBSCURA_TLS_CERT_SOURCE=../local-secure/secrets/flight.crt
DAL_OBSCURA_TLS_KEY_SOURCE=../local-secure/secrets/flight.key
DAL_OBSCURA_TLS_CLIENT_CA_SOURCE=../local-secure/secrets/client-ca.crt
DAL_OBSCURA_UI_TLS_CERT_SOURCE=../local-secure/secrets/ui.crt
DAL_OBSCURA_UI_TLS_KEY_SOURCE=../local-secure/secrets/ui.key
