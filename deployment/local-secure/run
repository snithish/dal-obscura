#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PRODUCTION="$ROOT/../production/compose.yaml"
PROFILE="$ROOT/.env"
OVERRIDE="$ROOT/compose.yaml"

compose() {
  docker compose --env-file "$PROFILE" -f "$PRODUCTION" -f "$OVERRIDE" "$@"
}

validate_profile() {
  if grep -Eq '^[A-Za-z_][A-Za-z0-9_]*=.*REPLACE_WITH' "$PROFILE"; then
    echo "$PROFILE still contains REPLACE_WITH placeholders; replace every secret and image digest before starting" >&2
    exit 2
  fi
  for required in flight.crt flight.key client-ca.crt ui.crt ui.key; do
    if [ ! -r "$ROOT/secrets/$required" ]; then
      echo "Missing readable TLS material: $ROOT/secrets/$required (run ./run init)" >&2
      exit 2
    fi
  done
}

usage() {
  cat <<'EOF'
Usage:
  ./run init       generate local TLS material (never commits it)
  ./run config     render and validate the layered topology
  ./run up         migrate and start the secure-local services
  ./run doctor     report redacted local TLS, origin, service and auth state
  ./run down       stop services without deleting PostgreSQL data
  ./run reset      stop services and delete the local database volume
  ./run logs [svc] show logs (default: edge)
EOF
}

profile_value() {
  sed -n "s/^$1=//p" "$PROFILE" | head -n 1
}

doctor() {
  [ -f "$PROFILE" ] || { echo "Create $PROFILE first" >&2; exit 2; }
  validate_profile
  compose config --quiet

  callback=$(profile_value DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_REDIRECT_URI)
  origin=invalid
  callback_state=invalid
  case "$callback" in
    https://*/auth/callback)
      origin=${callback%/auth/callback}
      callback_state=validated
      ;;
  esac

  bootstrap_state=disabled
  [ "$(profile_value DAL_OBSCURA_CONTROL_PLANE_BOOTSTRAP_ENABLED)" = "false" ] || bootstrap_state=unexpected

  browser_oidc_state=missing
  if [ -n "$(profile_value DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_ISSUER)" ] \
    && [ -n "$(profile_value DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_CLIENT_ID)" ] \
    && [ "$callback_state" = validated ]; then
    browser_oidc_state=configured
  fi

  ui_tls_state=invalid-ca
  if openssl verify -CAfile "$ROOT/secrets/ca.crt" "$ROOT/secrets/ui.crt" >/dev/null 2>&1; then
    ui_tls_state=valid-ca
  fi
  ui_tls_san_state=invalid
  if openssl x509 -in "$ROOT/secrets/ui.crt" -noout -text 2>/dev/null \
    | grep -Eq 'DNS:localhost|IP Address:127\.0\.0\.1'; then
    ui_tls_san_state=localhost
  fi

  service_state=$(compose ps --format '{{.Service}}={{.State}}' 2>/dev/null || true)
  [ -n "$service_state" ] || service_state=not-running

  printf '%s\n' \
    'profile=secure-local' \
    "public_origin=$origin" \
    "callback=$callback_state" \
    "bootstrap=$bootstrap_state" \
    "browser_oidc=$browser_oidc_state" \
    'flight_endpoint=loopback-only' \
    "ui_tls=$ui_tls_state" \
    "ui_tls_san=$ui_tls_san_state" \
    "services=$service_state" \
    'connector=not-configured' \
    'cloudflare_access=not-verified (secure-local does not claim external edge protection)'
}

init_tls() {
  mkdir -p "$ROOT/secrets"
  chmod 700 "$ROOT/secrets"
  if [ ! -f "$ROOT/secrets/ca.key" ]; then
    openssl genrsa -out "$ROOT/secrets/ca.key" 3072
    openssl req -x509 -new -nodes -key "$ROOT/secrets/ca.key" -sha256 -days 365 \
      -subj "/CN=dal-obscura secure-local CA" -out "$ROOT/secrets/ca.crt"
  fi
  if [ ! -f "$ROOT/secrets/ui.key" ]; then
    openssl genrsa -out "$ROOT/secrets/ui.key" 2048
    openssl req -new -key "$ROOT/secrets/ui.key" -subj "/CN=localhost" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" -out "$ROOT/secrets/ui.csr"
    printf 'subjectAltName=DNS:localhost,IP:127.0.0.1\n' > "$ROOT/secrets/ui.ext"
    openssl x509 -req -in "$ROOT/secrets/ui.csr" -CA "$ROOT/secrets/ca.crt" \
      -CAkey "$ROOT/secrets/ca.key" -CAcreateserial -days 365 -sha256 \
      -extfile "$ROOT/secrets/ui.ext" \
      -out "$ROOT/secrets/ui.crt"
  fi
  # Flight and the browser edge use separate private keys even though both
  # certificates are issued by the disposable local CA. Replace the original
  # profile's copied UI key on the next init so the boundaries are repaired.
  if [ ! -f "$ROOT/secrets/flight.key" ] || cmp -s "$ROOT/secrets/ui.key" "$ROOT/secrets/flight.key"; then
    openssl genrsa -out "$ROOT/secrets/flight.key" 2048
    openssl req -new -key "$ROOT/secrets/flight.key" -subj "/CN=localhost" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1" -out "$ROOT/secrets/flight.csr"
    printf 'subjectAltName=DNS:localhost,IP:127.0.0.1\n' > "$ROOT/secrets/flight.ext"
    openssl x509 -req -in "$ROOT/secrets/flight.csr" -CA "$ROOT/secrets/ca.crt" \
      -CAkey "$ROOT/secrets/ca.key" -CAcreateserial -days 365 -sha256 \
      -extfile "$ROOT/secrets/flight.ext" \
      -out "$ROOT/secrets/flight.crt"
    rm -f "$ROOT/secrets/flight.csr" "$ROOT/secrets/flight.ext"
  fi
  cp "$ROOT/secrets/ca.crt" "$ROOT/secrets/client-ca.crt"
  chmod 600 "$ROOT/secrets"/*.key
  chmod 644 "$ROOT/secrets"/*.crt
  rm -f "$ROOT/secrets/ca.srl" "$ROOT/secrets/ui.csr" "$ROOT/secrets/ui.ext"
  echo "TLS material written to $ROOT/secrets; copy .env.example to .env and configure a real OIDC issuer."
}

if [ "$#" -eq 0 ]; then usage >&2; exit 2; fi
case "$1" in
  init) init_tls ;;
  config) [ -f "$PROFILE" ] || { echo "Create $PROFILE first" >&2; exit 2; }; validate_profile; compose config --quiet ;;
  up) [ -f "$PROFILE" ] || { echo "Create $PROFILE first" >&2; exit 2; }; validate_profile; compose up -d --wait ;;
  doctor) doctor ;;
  down) [ -f "$PROFILE" ] || exit 0; compose down ;;
  reset) [ -f "$PROFILE" ] || exit 0; compose down --volumes --remove-orphans ;;
  logs) [ -f "$PROFILE" ] || { echo "Create $PROFILE first" >&2; exit 2; }; validate_profile; compose logs "${2:-edge}" ;;
  *) usage >&2; exit 2 ;;
esac
