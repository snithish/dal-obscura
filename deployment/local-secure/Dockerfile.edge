ARG EDGE_IMAGE
FROM ${EDGE_IMAGE}

# Official Caddy carries NET_BIND_SERVICE on its executable. Removing it lets
# an unprivileged high-port edge run with cap_drop: ALL on Docker and Podman.
USER root
RUN setcap -r /usr/bin/caddy
ENV HOME=/tmp \
    XDG_DATA_HOME=/tmp/caddy-data \
    XDG_CONFIG_HOME=/tmp/caddy-config
USER 10001:10001
