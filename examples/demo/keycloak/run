#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
COMPOSE_FILE="$ROOT/compose.yaml"
DEMO_IMAGE="${DAL_OBSCURA_IMAGE:-dal-obscura-demo:local}"

usage() {
  cat <<'EOF'
Usage:
  ./run up
  ./run credentials
  ./run certificate
  ./run podman-ports enable|disable
  ./run token --as <user>
  ./run read --as <user> [read-args...]
  ./run smoke
  ./run ui-smoke
  ./run logs [service]
  ./run down
  ./run reset

Users:
  demo-admin, asset-owner, us-analyst, eu-analyst, data-steward, blocked-user
EOF
}

prepare() {
  python3 "$ROOT/scripts/prepare_demo.py"
}

is_podman_on_macos() {
  [ "$(uname -s)" = Darwin ] || return 1
  command -v podman >/dev/null 2>&1 || return 1
  client_version="$(podman version --format '{{.Client.Version}}' 2>/dev/null || true)"
  server_version="$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
  [ -n "$client_version" ] && [ "$client_version" = "$server_version" ]
}

compose() {
  project_name="${DAL_OBSCURA_DEMO_PROJECT_NAME:-dal-obscura-keycloak-demo}"
  gateway_http_port=80
  gateway_https_port=443
  if is_podman_on_macos; then
    gateway_http_port=18080
    gateway_https_port=18443
  fi
  DAL_OBSCURA_IMAGE="$DEMO_IMAGE" \
    DAL_OBSCURA_DEMO_CADDY_HTTP_PORT="$gateway_http_port" \
    DAL_OBSCURA_DEMO_CADDY_HTTPS_PORT="$gateway_https_port" \
    docker compose --project-name "$project_name" -f "$COMPOSE_FILE" "$@"
}

build_image() {
  if [ -z "${DAL_OBSCURA_IMAGE:-}" ]; then
    docker build -t "$DEMO_IMAGE" "$ROOT/../../.."
  fi
}

credentials() {
  prepare >/dev/null
  ui_origin="$(sed -n 's/^DAL_OBSCURA_CONTROL_PLANE_UI_OIDC_ORIGIN=//p' "$ROOT/.runtime/control-plane.env")"
  printf 'Control plane UI: %s\n' "${ui_origin:-https://governance.localhost}"
  printf 'API docs:         https://api.localhost/docs\n'
  printf 'Keycloak:         https://keycloak.localhost\n'
  printf 'OIDC callback:    %s/auth/callback\n' "${ui_origin:-https://governance.localhost}"
  printf 'Flight URI:       grpc+tcp://127.0.0.1:8815\n'
  printf '\n'
  sed -n \
    -e 's/^DAL_OBSCURA_CONTROL_PLANE_ADMIN_TOKEN=/Admin token: /p' \
    "$ROOT/.runtime/control-plane.env"
  sed -n \
    -e 's/^DEMO_ADMIN_PASSWORD=/demo-admin password: /p' \
    -e 's/^ASSET_OWNER_PASSWORD=/asset-owner password: /p' \
    -e 's/^US_ANALYST_PASSWORD=/us-analyst password: /p' \
    -e 's/^EU_ANALYST_PASSWORD=/eu-analyst password: /p' \
    -e 's/^DATA_STEWARD_PASSWORD=/data-steward password: /p' \
    -e 's/^BLOCKED_USER_PASSWORD=/blocked-user password: /p' \
    "$ROOT/.runtime/client.env"
}

certificate() {
  prepare >/dev/null
  compose exec -T caddy test -s /data/caddy/pki/authorities/local/root.crt
  compose cp caddy:/data/caddy/pki/authorities/local/root.crt "$ROOT/.runtime/caddy-root.crt"
  printf 'Caddy local CA: %s\n' "$ROOT/.runtime/caddy-root.crt"
}

token() {
  user="asset-owner"
  if [ "${1:-}" = "--as" ]; then
    user="${2:-}"
  fi
  compose exec client python /workspace/demo/scripts/print_token.py --as "$user"
}

if [ "$#" -eq 0 ]; then
  usage >&2
  exit 2
fi

action="$1"
shift || true

case "$action" in
  up)
    prepare
    build_image
    if is_podman_on_macos; then
      sh "$ROOT/scripts/podman_loopback_ports.sh" enable
    fi
    compose up -d --build --wait
    credentials
    ;;
  credentials)
    credentials
    ;;
  certificate)
    certificate
    ;;
  token)
    token "$@"
    ;;
  read)
    compose exec client python /workspace/demo/scripts/read_demo.py "$@"
    ;;
  smoke)
    compose exec client python /workspace/demo/scripts/smoke_demo.py
    ;;
  ui-smoke)
    python3 "$ROOT/scripts/ui_smoke.py"
    ;;
  logs)
    compose logs "${1:-control-plane}"
    ;;
  down)
    compose down
    if is_podman_on_macos; then
      sh "$ROOT/scripts/podman_loopback_ports.sh" disable
    fi
    ;;
  reset)
    compose down --volumes --remove-orphans
    if is_podman_on_macos; then
      sh "$ROOT/scripts/podman_loopback_ports.sh" disable
    fi
    rm -rf "$ROOT/.runtime"
    ;;
  podman-ports)
    if ! is_podman_on_macos; then
      echo "Podman loopback port forwarding is only for Podman on macOS" >&2
      exit 2
    fi
    sh "$ROOT/scripts/podman_loopback_ports.sh" "${1:-}"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
