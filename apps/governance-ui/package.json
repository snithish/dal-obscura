{
  "name": "@dal-obscura/governance-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev": "vite",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:stories": "vitest run --config vitest.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "generate:api-types": "node scripts/generate-api-types.mjs",
    "check:api-types": "node scripts/generate-api-types.mjs --check"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tanstack/react-query": "5.102.8",
    "get-nonce": "1.0.1",
    "lucide-react": "1.45.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "4.1.11",
    "openapi-typescript": "7.13.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
